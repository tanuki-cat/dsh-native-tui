{
  "name": "dsh-native-tui",
  "version": "0.2.1-rc.2",
  "private": true,
  "license": "MIT",
  "description": "DeepSeek Harness host-native terminal front door built on pi-tui",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/minimal.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./mcp-manager": {
      "types": "./dist/mcp-manager.d.ts",
      "default": "./dist/mcp-manager.js"
    },
    "./codebuddy": {
      "types": "./dist/codebuddy.d.ts",
      "default": "./dist/codebuddy.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "presets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "spike:carrier": "node --import tsx src/spike/carrier.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@earendil-works/pi-tui": "1.3.0",
    "fflate": "^0.8.3",
    "@deepseek-ai/dsh-computer-use": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-native": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-resources": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-stats": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-file-reference": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-alpha.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-file-reference": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@types/node": "^22.20.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "@deepseek-ai/dsh-file-reference": {
      "optional": true
    }
  }
}
